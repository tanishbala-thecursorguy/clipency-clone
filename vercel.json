    {
      "source": "/client/landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/client/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing-mobile",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing-mobile/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/clipper",
      "destination": "/client/clipper",
      "permanent": false
    },
    {
      "source": "/client/client-dashboard",
      "destination": "/client/home",
      "permanent": false
    },
    {
      "source": "/client-dashboard",
      "destination": "/client/home",
      "permanent": false
    },
    {
      "source": "/clipency",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/clipency/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/clipency/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/client/home",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/client/clipper-signin",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "/client/clipper-signin",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/client/clipper",
      "permanent": false
    },
    {
      "source": "/profile",
      "destination": "/client/clipper",
      "permanent": false
    },
    {
      "source": "/campaigns",
      "destination": "/client/clipper",
      "permanent": false
    },
    {
      "source": "/stats",
      "destination": "/client/clipper",
      "permanent": false
    },
    {
      "source": "/payouts",
      "destination": "/client/clipper",
      "permanent": false
    },
    {
      "source": "/wallet",
      "destination": "/client/clipper",
      "permanent": false
    },
    {
      "source": "/accounts",
      "destination": "/client/clipper",
      "permanent": false
    },
    {
      "source": "/workspace",
      "destination": "/client/clipper",
      "permanent": false
    },
    {
      "source": "/admin/reviews",
      "destination": "/console",
      "permanent": false
    },
    {
      "source": "/admin/review",
      "destination": "/console",
      "permanent": false
    },
    {
      "source": "/admin/payouts",
